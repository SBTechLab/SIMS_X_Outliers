{
  "name": "sunpower-sims",
  "version": "0.1.0",
  "private": true,
  "description": "SunPower SIMS — Solar Installation Management System for SunPower Solutions",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup": "npm install && npm run db:generate && npm run db:push && npm run seed",
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "smoke": "node server/scripts/smoke.js",
    "db:generate": "npm run db:generate --workspace server",
    "db:push": "npm run db:push --workspace server",
    "db:reset": "npm run db:reset --workspace server && npm run seed",
    "db:studio": "npm run db:studio --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
